# Telegram Bot Token (obtain from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Database URL (SQLite async by default)
DATABASE_URL=sqlite+aiosqlite:///./jobhunter.db

# Daily Digest Schedule (24-hour format: HH:MM, e.g., 09:00 for 9 AM)
DIGEST_TIME=09:00

# Scraper Interval in hours (e.g. scrape every 4 hours)
SCRAPE_INTERVAL_HOURS=4

# Minimum Match Score threshold (0-100) to notify user
MATCH_THRESHOLD=60

# Optional AI API Key (OpenAI / Gemini) for advanced semantic matching & summaries
OPENAI_API_KEY=
